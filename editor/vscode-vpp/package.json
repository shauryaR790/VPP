{
  "name": "vplusplus",
  "displayName": "v++ Language",
  "description": "Official v++  -  Python-readable syntax, native compilation. Debug, watch, REPL, bench, format, test, LSP.",
  "version": "1.2.1",
  "publisher": "vpp-lang",
  "license": "MIT",
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#1a1a1a",
    "theme": "dark"
  },
  "keywords": [
    "vpp",
    "v++",
    "programming language",
    "vpp-lang",
    "native",
    "compiled",
    "python-like",
    "debugger"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/shauryaR790/VPP.git"
  },
  "bugs": {
    "url": "https://github.com/shauryaR790/VPP/issues"
  },
  "homepage": "https://github.com/shauryaR790/VPP#readme",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": ["Programming Languages", "Formatters", "Testing", "Debuggers"],
  "activationEvents": [
    "onLanguage:vpp",
    "workspaceContains:**/*.vpp"
  ],
  "main": "./extension.js",
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "contributes": {
    "languages": [
      {
        "id": "vpp",
        "aliases": ["v++", "vpp"],
        "extensions": [".vpp"],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/vpp.png",
          "dark": "./icons/vpp-dark.png"
        }
      }
    ],
    "grammars": [
      {
        "language": "vpp",
        "scopeName": "source.vpp",
        "path": "./syntaxes/vpp.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "vpp",
        "path": "./snippets/vpp.code-snippets"
      }
    ],
    "iconThemes": [
      {
        "id": "vpp-icons",
        "label": "v++ Icons",
        "path": "./icons/vpp-icon-theme.json"
      }
    ],
    "commands": [
      {
        "command": "vpp.debugFile",
        "title": "v++: Debug File",
        "icon": "$(debug-alt)"
      },
      {
        "command": "vpp.runFile",
        "title": "v++: Run File",
        "icon": "$(play)"
      },
      {
        "command": "vpp.checkFile",
        "title": "v++: Check File",
        "icon": "$(check)"
      },
      {
        "command": "vpp.formatDocument",
        "title": "v++: Format Document",
        "icon": "$(symbol-keyword)"
      },
      {
        "command": "vpp.startRepl",
        "title": "v++: Start REPL",
        "icon": "$(terminal)"
      },
      {
        "command": "vpp.watchFile",
        "title": "v++: Watch File (live re-run on save)",
        "icon": "$(eye)"
      },
      {
        "command": "vpp.benchFile",
        "title": "v++: Benchmark File",
        "icon": "$(dashboard)"
      },
      {
        "command": "vpp.testProject",
        "title": "v++: Run Tests",
        "icon": "$(beaker)"
      },
      {
        "command": "vpp.refreshTests",
        "title": "v++: Refresh Test Explorer",
        "icon": "$(refresh)"
      },
      {
        "command": "vpp.searchPackages",
        "title": "v++: Search Package Registry",
        "icon": "$(search)"
      },
      {
        "command": "vpp.showOutput",
        "title": "v++: Show Output"
      },
      {
        "command": "vpp.openSettings",
        "title": "v++: Open Settings"
      },
      {
        "command": "vpp.openDocs",
        "title": "v++: Open Documentation"
      }
    ],
    "menus": {
      "editor/title/run": [
        {
          "command": "vpp.debugFile",
          "when": "resourceLangId == vpp",
          "group": "navigation@0"
        },
        {
          "command": "vpp.runFile",
          "when": "resourceLangId == vpp",
          "group": "navigation"
        },
        {
          "command": "vpp.watchFile",
          "when": "resourceLangId == vpp",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "vpp.runFile",
          "when": "resourceLangId == vpp",
          "group": "navigation@1"
        },
        {
          "command": "vpp.checkFile",
          "when": "resourceLangId == vpp",
          "group": "navigation@2"
        },
        {
          "command": "vpp.formatDocument",
          "when": "resourceLangId == vpp",
          "group": "1_modification@1"
        }
      ],
      "commandPalette": [
        {
          "command": "vpp.runFile",
          "when": "resourceLangId == vpp"
        },
        {
          "command": "vpp.checkFile",
          "when": "resourceLangId == vpp"
        },
        {
          "command": "vpp.formatDocument",
          "when": "resourceLangId == vpp"
        },
        {
          "command": "vpp.watchFile",
          "when": "resourceLangId == vpp"
        },
        {
          "command": "vpp.benchFile",
          "when": "resourceLangId == vpp"
        },
        {
          "command": "vpp.startRepl"
        },
        {
          "command": "vpp.testProject"
        },
        {
          "command": "vpp.showOutput"
        },
        {
          "command": "vpp.openSettings"
        },
        {
          "command": "vpp.openDocs"
        }
      ]
    },
    "keybindings": [
      {
        "command": "vpp.runFile",
        "key": "ctrl+shift+r",
        "when": "resourceLangId == vpp && editorTextFocus"
      },
      {
        "command": "vpp.debugFile",
        "key": "f5",
        "when": "resourceLangId == vpp && editorTextFocus"
      },
      {
        "command": "vpp.runFile",
        "key": "ctrl+f5",
        "when": "resourceLangId == vpp && editorTextFocus"
      },
      {
        "command": "vpp.formatDocument",
        "key": "shift+alt+f",
        "when": "resourceLangId == vpp && editorTextFocus"
      }
    ],
    "debuggers": [
      {
        "type": "vpp",
        "label": "v++",
        "languages": ["vpp"],
        "configurationAttributes": {
          "launch": {
            "required": ["program"],
            "properties": {
              "program": {
                "type": "string",
                "description": "Path to a .vpp file to debug (interpreter; same as run/repl)"
              },
              "stopOnEntry": {
                "type": "boolean",
                "default": true,
                "description": "Pause on first line"
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "vpp",
            "request": "launch",
            "name": "Debug v++ file",
            "program": "${file}",
            "stopOnEntry": true
          }
        ]
      }
    ],
    "configuration": {
      "title": "v++",
      "properties": {
        "vpp.compilerPath": {
          "type": "string",
          "default": "",
          "description": "Path to vpp.exe. Leave empty to auto-detect (vpp.ps1 or target/debug/vpp.exe in workspace)."
        },
        "vpp.languageServerPath": {
          "type": "string",
          "default": "vppls",
          "description": "Path to the v++ language server (build with: cargo build --features lsp --bin vppls)"
        },
        "vpp.enableLanguageServer": {
          "type": "boolean",
          "default": true,
          "description": "Start vppls for diagnostics, completion, and go-to-definition when a .vpp file is opened."
        },
        "vpp.formatOnSave": {
          "type": "boolean",
          "default": true,
          "description": "Format .vpp files with vpp fmt on save."
        }
      }
    }
  }
}
